{
  "ci": {
    "collect": {
      "staticDistDir": ".vercel/output/static",
      "url": [
        "http://localhost/es/index.html",
        "http://localhost/en/projects/index.html",
        "http://localhost/es/projects/dra-vale-boquitas/index.html",
        "http://localhost/en/blog/islas-astro-seo/index.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
