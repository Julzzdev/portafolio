# Formulario de contacto (Resend: https://resend.com)
# Con el remitente onboarding@resend.dev, Resend sólo entrega al correo con el que se creó la cuenta
RESEND_API_KEY=
# Opcional: por defecto se usa sitio.email (src/config/sitio.ts)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Portafolio <onboarding@resend.dev>"

# Anti-spam opcional (Cloudflare Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
