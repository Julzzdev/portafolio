---
import '../styles/global.css';
import fuenteTitulos from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { idiomas } from '../i18n/ui';
import { getIdiomaDeUrl, usarTraducciones } from '../i18n/utils';

type Props = import('astro/types').ComponentProps<typeof SEO>;

const idioma = getIdiomaDeUrl(Astro.url);
const t = usarTraducciones(idioma);
// Los scripts de /_vercel/* sólo existen en despliegues de Vercel; fuera de ahí darían 404
const enVercel = !!process.env.VERCEL;
---

<!doctype html>
<html lang={idiomas[idioma].bcp47} class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={fuenteTitulos} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b1013" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />
    <SEO {...Astro.props} />

    <!-- Aplica el tema antes de pintar para evitar parpadeo -->
    <script is:inline>
      (() => {
        const guardado = localStorage.getItem('tema');
        const claro = guardado ? guardado === 'light' : !matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', !claro);
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-tinta focus:px-4 focus:py-2 focus:text-fondo"
    >
      {t('nav.saltar')}
    </a>
    <Header alternos={Astro.props.alternos} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    {
      enVercel && (
        <>
          <Analytics />
          <SpeedInsights />
        </>
      )
    }
  </body>
</html>
