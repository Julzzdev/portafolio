---
import Base from '../layouts/Base.astro';
import BotonLink from '../components/BotonLink.astro';
import Paletas from '../components/Paletas.astro';
import { getIdiomaDeUrl, ruta, usarTraducciones } from '../i18n/utils';

const idioma = getIdiomaDeUrl(Astro.url);
const t = usarTraducciones(idioma);
---

<Base titulo={`404 · ${t('404.titulo')}`} descripcion={t('404.texto')} noIndex alternos={[]} imagen={`/og/${idioma}.png`}>
  <div class="mx-auto grid max-w-xl place-items-center px-5 py-32 text-center">
    <p class="text-8xl"><span class="sr-only">404</span><Paletas texto="404" tono="amarillo" /></p>
    <h1 class="titulo-rotulo mt-6 text-5xl">{t('404.titulo')}</h1>
    <p class="mt-3 text-tinta-suave">{t('404.texto')}</p>
    <div class="mt-8"><BotonLink href={ruta(idioma)}>{t('404.volver')}</BotonLink></div>
  </div>
</Base>
