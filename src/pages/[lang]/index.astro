---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Seccion from '../../components/Seccion.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PostCard from '../../components/PostCard.astro';
import BotonLink from '../../components/BotonLink.astro';
import Hero3DLoader from '../../components/islands/Hero3DLoader';
import RoleRotator from '../../components/islands/RoleRotator';
import { sitio } from '../../config/sitio';
import { certificaciones, destacados as cifras } from '../../data/experiencia';
import { getPosts, getProyectos } from '../../lib/contenido';
import { personaLd, sitioWebLd } from '../../lib/schema';
import { pathsIdiomas, ruta, usarTraducciones } from '../../i18n/utils';
import { idiomas, type Idioma } from '../../i18n/ui';

export const getStaticPaths = pathsIdiomas;

const idioma = Astro.params.lang as Idioma;
const t = usarTraducciones(idioma);
const destacados = (await getProyectos(idioma)).filter((p) => p.data.featured).slice(0, 4);
const posts = (await getPosts(idioma)).slice(0, 3);
const roles = t('hero.roles').split('|');
const site = Astro.site!;
---

<Base
  titulo={t('meta.titulo')}
  descripcion={t('meta.descripcion')}
  jsonLd={[personaLd(site), sitioWebLd(site, idiomas[idioma].bcp47)]}
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-32 left-1/2 size-[36rem] -translate-x-1/2 rounded-full bg-acento/20 blur-3xl animate-flotar lg:left-3/4"></div>
      <div class="absolute top-40 -left-24 size-[24rem] rounded-full bg-acento-2/15 blur-3xl animate-flotar [animation-delay:-4s]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--borde)_1px,transparent_1px),linear-gradient(to_bottom,var(--borde)_1px,transparent_1px)] bg-[size:56px_56px] opacity-40 [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_70%)]"></div>
    </div>

    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 pt-20 pb-16 sm:pt-28 lg:grid-cols-[1.15fr_1fr] lg:pb-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-borde bg-superficie/70 px-3 py-1 font-mono text-xs text-tinta-suave">
          <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span></span>
          {t('hero.rol')} · {sitio.ubicacion}
        </p>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-6xl">
          <span class="block text-tinta-suave text-2xl font-semibold sm:text-3xl">{t('hero.saludo')}</span>
          {sitio.nombre}
          <span class="mt-2 block text-3xl sm:text-5xl">
            <RoleRotator client:idle roles={roles} />
          </span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-tinta-suave">{t('hero.intro')}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <BotonLink href={ruta(idioma, 'projects')}>{t('hero.ctaProyectos')} →</BotonLink>
          <BotonLink href={ruta(idioma, 'contact')} variante="secundario">{t('hero.ctaContacto')}</BotonLink>
        </div>
        {
          certificaciones.map((c) => (
            <a
              href={ruta(idioma, 'cv')}
              class="mt-8 inline-flex items-center gap-3 rounded-2xl border border-[#d97757]/40 bg-[#d97757]/10 py-2 pr-4 pl-2 text-sm transition hover:border-[#d97757]/70"
            >
              {
                c.imagen ? (
                  <Image src={c.imagen} alt="" width={44} height={44} densities={[1, 2, 3]} class="size-11" />
                ) : (
                  <span class="grid size-8 place-items-center rounded-xl bg-[#d97757] text-base text-white" aria-hidden="true">✦</span>
                )
              }
              <span>
                <span class="block font-semibold">{c.nombre}</span>
                <span class="block text-xs text-tinta-suave">{t('hero.certificacion')}</span>
              </span>
            </a>
          ))
        }
      </div>
      <div class="relative hidden aspect-square w-full lg:block">
        <Hero3DLoader client:idle />
      </div>
    </div>
  </section>

  <!-- Cifras -->
  <section class="mx-auto max-w-6xl px-5" aria-label={t('home.cifras')}>
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-borde bg-borde lg:grid-cols-4">
      {
        cifras.map(({ valor, texto }) => (
          <div class="flex flex-col-reverse gap-1 bg-superficie p-6">
            <dt class="text-sm text-tinta-suave">{texto[idioma]}</dt>
            <dd class="texto-gradiente text-4xl font-extrabold tracking-tight">{valor}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Proyectos destacados (bento) -->
  <Seccion titulo={t('home.destacados')} subtitulo={t('home.destacadosSub')}>
    <BotonLink slot="accion" href={ruta(idioma, 'projects')} variante="secundario">{t('home.verTodos')} →</BotonLink>
    <div class="grid gap-6 md:grid-cols-2">
      {destacados.map((proyecto, i) => <ProjectCard proyecto={proyecto} grande={i === 0 && destacados.length % 2 === 1} />)}
    </div>
  </Seccion>

  <!-- Stack -->
  <Seccion titulo={t('home.stack')}>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        Object.entries(sitio.habilidades).map(([grupo, lista]) => (
          <div class="rounded-3xl border border-borde bg-superficie p-6">
            <h3 class="font-mono text-sm text-acento">{t(`stack.${grupo as keyof typeof sitio.habilidades}`)}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {lista.map((h) => <li class="rounded-full bg-borde/50 px-3 py-1.5 text-sm">{h}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </Seccion>

  {
    posts.length > 0 && (
      <Seccion titulo={t('home.blog')}>
        <BotonLink slot="accion" href={ruta(idioma, 'blog')} variante="secundario">{t('home.verBlog')} →</BotonLink>
        <div class="grid gap-6 md:grid-cols-3">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </Seccion>
    )
  }

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="relative overflow-hidden rounded-[2rem] border border-borde bg-superficie px-8 py-14 text-center sm:px-16">
      <div aria-hidden="true" class="absolute inset-0 -z-0 bg-[radial-gradient(circle_at_30%_0%,var(--acento),transparent_45%),radial-gradient(circle_at_80%_100%,var(--acento-2),transparent_40%)] opacity-20"></div>
      <div class="relative">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('home.ctaTitulo')}</h2>
        <p class="mx-auto mt-3 max-w-lg text-tinta-suave">{t('home.ctaTexto')}</p>
        <div class="mt-8 flex justify-center">
          <BotonLink href={ruta(idioma, 'contact')}>{t('hero.ctaContacto')} →</BotonLink>
        </div>
      </div>
    </div>
  </section>
</Base>
