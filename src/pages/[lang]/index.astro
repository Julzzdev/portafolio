---
import Base from '../../layouts/Base.astro';
import Flecha from '../../components/Flecha.astro';
import Andenes from '../../components/Andenes.astro';
import Estado from '../../components/Estado.astro';
import { sitio } from '../../config/sitio';
import { DIENTE, paradas } from '../../data/kirei';
import { getPosts, getProyectos } from '../../lib/contenido';
import { personaLd, sitioWebLd } from '../../lib/schema';
import { formatearFecha, pathsIdiomas, ruta, separarId, usarTraducciones } from '../../i18n/utils';
import { idiomas, type Idioma } from '../../i18n/ui';

export const getStaticPaths = pathsIdiomas;

const idioma = Astro.params.lang as Idioma;
const t = usarTraducciones(idioma);
const proyectos = await getProyectos(idioma);
const posts = (await getPosts(idioma)).slice(0, 3);
const site = Astro.site!;

const evidencia = [
  { valor: '5+', texto: t('evidencia.anios'), href: ruta(idioma, 'cv') },
  { valor: '20+', texto: t('evidencia.bancos'), href: ruta(idioma, 'cv') },
  { valor: 'Fortune 500', texto: t('evidencia.empresas'), href: ruta(idioma, 'cv') },
  { valor: 'Anthropic', texto: t('evidencia.cert'), href: ruta(idioma, 'cv') },
];
const principios = [1, 2, 3, 4] as const;
---

<Base
  titulo={t('meta.titulo')}
  descripcion={t('meta.descripcion')}
  jsonLd={[personaLd(site), sitioWebLd(site, idiomas[idioma].bcp47)]}
>
  <!-- Portada -->
  <section class="relative overflow-hidden border-b border-borde">
    <div class="rejilla pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="contenedor relative grid gap-12 py-14 sm:py-20 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-center lg:gap-16 lg:py-24">
      <div>
        <p class="etiqueta flex flex-wrap items-center gap-x-3 gap-y-1">
          <span>{sitio.marca}</span>
          <span aria-hidden="true">/</span>
          <span>{sitio.ubicacion}</span>
          <span data-reloj-texto hidden><span aria-hidden="true">/</span> {t('hero.hora')} <time data-reloj class="tabular-nums"></time></span>
        </p>
        <h1 class="titulo mt-6 max-w-[16ch] text-[2.75rem] sm:text-6xl xl:text-7xl">{t('hero.titulo')}</h1>
        <p class="mt-6 max-w-[54ch] text-lg leading-relaxed text-tinta-suave sm:text-xl">{t('hero.firma')}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#kirei" class="boton boton-primario">{t('kirei.cta')} <Flecha dir="abajo" /></a>
          <a href={ruta(idioma, 'projects')} class="boton boton-secundario">{t('hero.ctaProyectos')}</a>
        </div>
      </div>

      <!-- Estado de los proyectos -->
      <div class="rounded-2xl border border-borde bg-superficie shadow-[0_1px_0_var(--borde),0_24px_48px_-24px_rgb(13_27_30/0.18)]">
        <div class="flex items-center justify-between gap-4 border-b border-borde px-5 py-3.5">
          <h2 class="text-sm font-semibold">{t('panel.titulo')}</h2>
          <a href={ruta(idioma, 'projects')} class="font-mono text-xs text-tinta-suave hover:text-tinta">{t('panel.todos')} →</a>
        </div>
        <ul class="divide-y divide-borde">
          {
            proyectos.map((p) => (
              <li>
                <a
                  href={ruta(idioma, `projects/${separarId(p.id).slug}`)}
                  class:list={['flex items-center justify-between gap-4 px-5 transition-colors hover:bg-superficie-2', p.data.anden === 'producto' ? 'py-4' : 'py-2.5']}
                >
                  <span class="min-w-0">
                    <span class:list={['block font-semibold', p.data.anden === 'producto' ? 'text-lg' : 'text-[0.95rem]']}>{p.data.corto}</span>
                    <span class="block truncate text-sm text-tinta-suave">{p.data.para}</span>
                  </span>
                  <Estado estado={p.data.estado} idioma={idioma} simple />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Evidencia -->
    <div class="relative border-t border-borde bg-superficie">
      <h2 class="sr-only">{t('evidencia.titulo')}</h2>
      <dl class="contenedor grid grid-cols-2 lg:grid-cols-4">
        {
          evidencia.map(({ valor, texto }, i) => (
            <div class:list={['flex flex-col-reverse gap-1 py-6 sm:py-8', i % 2 === 1 && 'border-l border-borde pl-5 sm:pl-8', i === 2 && 'lg:border-l lg:pl-8', i >= 2 && 'border-t border-borde lg:border-t-0']}>
              <dt class="text-sm leading-snug text-tinta-suave">{texto}</dt>
              <dd class="text-2xl font-semibold tracking-tight sm:text-3xl">{valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Kirei: su sección conserva su propia identidad -->
  <section id="kirei" class="bg-kirei-tinta text-kirei-esmalte">
    <div class="contenedor grid gap-14 py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-20 lg:py-28">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <p class="flex items-center gap-3 text-xl font-semibold">
          <svg viewBox="0 0 512 512" class="size-11" aria-hidden="true"><rect width="512" height="512" rx="112" fill="#1d6b73"></rect><path fill="#fff" d={DIENTE}></path></svg>
          Kirei
        </p>
        <h2 class="mt-7 font-kirei text-6xl leading-[0.98] font-light tracking-tight sm:text-7xl xl:text-[5.5rem]">
          {t('kirei.titulo.a')} <em class="font-normal text-kirei-menta">{t('kirei.titulo.b')}</em> {t('kirei.titulo.c')}
        </h2>
        <p class="mt-7 max-w-xl text-xl leading-relaxed text-kirei-esmalte/80">{t('kirei.texto')}</p>
        <p class="mt-5 max-w-xl leading-relaxed text-kirei-esmalte/80">{t('kirei.nacio')}</p>

        <dl class="mt-8 grid max-w-xl grid-cols-3 gap-px bg-kirei-esmalte/20">
          <div class="bg-kirei-tinta py-3 pr-3"><dt class="text-sm text-kirei-esmalte/70">Básico</dt><dd class="font-mono text-lg">$649</dd></div>
          <div class="bg-kirei-tinta py-3 pr-3 pl-4"><dt class="text-sm text-kirei-esmalte/70">Profesional</dt><dd class="font-mono text-lg">$1,099</dd></div>
          <div class="bg-kirei-tinta py-3 pr-3 pl-4"><dt class="text-sm text-kirei-esmalte/70">Clínica</dt><dd class="font-mono text-lg">$2,149</dd></div>
        </dl>
        <p class="mt-2 max-w-xl text-sm text-kirei-esmalte/70">{t('kirei.precios')}</p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={sitio.kirei.landing} class="inline-flex items-center gap-2 rounded-full bg-kirei-coral px-7 py-4 text-lg font-semibold text-kirei-tinta transition-colors duration-150 hover:bg-kirei-menta">
            {t('kirei.cta2')}
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 12h15m-6-7 7 7-7 7"></path></svg>
          </a>
          <p class="text-kirei-esmalte/80">{t('kirei.pronto')}</p>
        </div>
      </div>

      <div>
        <h3 class="font-kirei text-3xl font-light">{t('kirei.dia')}</h3>
        <ol class="mt-6">
          {
            paradas.map((p) => (
              <li class="grid grid-cols-[4.25rem_1.25rem_1fr] gap-x-3">
                <time class="pt-5 font-mono text-sm text-kirei-menta tabular-nums">{p.hora}</time>
                <span class="relative flex justify-center" aria-hidden="true">
                  <span class="absolute inset-y-0 w-0.5 bg-kirei-teal"></span>
                  <span class="relative mt-6 size-3 rounded-full bg-kirei-coral ring-4 ring-kirei-tinta"></span>
                </span>
                <div class="border-b border-kirei-esmalte/15 py-4">
                  <p class="font-kirei text-2xl leading-snug font-light">{p.titulo[idioma]}</p>
                  <p class="mt-1 text-sm text-kirei-esmalte/70">{p.modulo[idioma]}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Quién está detrás -->
  <section class="contenedor grid gap-10 py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:gap-16 lg:py-28">
    <div>
      <p class="etiqueta">{t('principios.titulo')}</p>
      <h2 class="titulo mt-4 text-4xl sm:text-5xl">{t('julio.titulo')}</h2>
      <p class="mt-6 text-xl leading-snug font-medium">{t('julio.a')}</p>
      <p class="mt-4 text-lg leading-relaxed text-tinta-suave">{t('julio.b')}</p>
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <a href={ruta(idioma, 'cv')} class="enlace">{t('julio.cv')}</a>
        <a href={sitio.github} rel="me noopener" target="_blank" class="enlace">GitHub</a>
      </p>
    </div>
    <ol class="grid self-start border-t border-borde sm:grid-cols-2">
      {
        principios.map((n, i) => (
          <li class:list={['border-b border-borde py-7', i % 2 === 1 ? 'sm:border-l sm:pl-8' : 'sm:pr-8']}>
            <span class="etiqueta">{String(n).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-semibold">{t(`principios.${n}.t`)}</h3>
            <p class="mt-2 leading-relaxed text-tinta-suave">{t(`principios.${n}.d`)}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Proyectos -->
  <section id="proyectos" class="contenedor pb-20 lg:pb-28">
    <h2 class="titulo mb-10 text-4xl sm:text-5xl">{t('home.salidas')}</h2>
    <Andenes idioma={idioma} proyectos={proyectos} />
  </section>

  {
    posts.length > 0 && (
      <section class="contenedor pb-20">
        <div class="mb-2 flex flex-wrap items-end justify-between gap-3 border-b border-tinta pb-3">
          <h2 class="text-2xl font-semibold tracking-tight">{t('home.blog')}</h2>
          <a href={ruta(idioma, 'blog')} class="enlace text-sm">{t('home.verBlog')}</a>
        </div>
        <ul>
          {posts.map((post) => (
            <li class="border-b border-borde">
              <a href={ruta(idioma, `blog/${separarId(post.id).slug}`)} class="group grid gap-x-8 gap-y-1 py-5 md:grid-cols-[10rem_1fr] md:px-4 hover:bg-superficie">
                <time datetime={post.data.pubDate.toISOString()} class="etiqueta pt-1">{formatearFecha(post.data.pubDate, idioma)}</time>
                <span>
                  <span class="block text-lg font-semibold group-hover:text-acento">{post.data.title}</span>
                  <span class="mt-1 block max-w-[70ch] text-tinta-suave">{post.data.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Cierre -->
  <section class="contenedor pb-20 lg:pb-28">
    <div class="relative overflow-hidden rounded-2xl border border-borde bg-superficie px-6 py-12 sm:px-12 sm:py-16">
      <div class="rejilla pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="titulo max-w-[20ch] text-4xl sm:text-5xl">{t('cierre.titulo')}</h2>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-tinta-suave">{t('cierre.texto')}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={ruta(idioma, 'contact')} class="boton boton-primario">{t('hero.ctaContacto')} <Flecha /></a>
          <a href={sitio.kirei.landing} class="boton boton-secundario">{t('kirei.cta')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Hora real del centro de México
  const reloj = document.querySelector<HTMLTimeElement>('[data-reloj]');
  if (reloj) {
    const formato = new Intl.DateTimeFormat('es-MX', { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit', hour12: false });
    const pinta = () => (reloj.textContent = formato.format(new Date()));
    pinta();
    document.querySelector<HTMLElement>('[data-reloj-texto]')!.hidden = false;
    setInterval(pinta, 20000);
  }
</script>
