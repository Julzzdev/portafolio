---
import Base from '../../layouts/Base.astro';
import Paletas from '../../components/Paletas.astro';
import Flecha from '../../components/Flecha.astro';
import Andenes from '../../components/Andenes.astro';
import { sitio } from '../../config/sitio';
import { DIENTE, paradas } from '../../data/kirei';
import { getPosts, getProyectos } from '../../lib/contenido';
import { personaLd, sitioWebLd } from '../../lib/schema';
import { formatearFecha, pathsIdiomas, ruta, separarId, usarTraducciones } from '../../i18n/utils';
import { idiomas, type Idioma } from '../../i18n/ui';

export const getStaticPaths = pathsIdiomas;

const idioma = Astro.params.lang as Idioma;
const t = usarTraducciones(idioma);
const proyectos = await getProyectos(idioma);
const siguientes = ['dra-vale-boquitas', 'pdf-policies-extractor', 'practica-japones']
  .map((slug) => proyectos.find((p) => separarId(p.id).slug === slug)!)
  .filter(Boolean);
const numeroAnden = { producto: 1, medida: 2, experimento: 3 } as const;
const posts = (await getPosts(idioma)).slice(0, 3);
const site = Astro.site!;
---

<Base
  titulo={t('meta.titulo')}
  descripcion={t('meta.descripcion')}
  jsonLd={[personaLd(site), sitioWebLd(site, idiomas[idioma].bcp47)]}
>
  <!-- Tablero de salidas -->
  <section class="banda" data-tablero>
    <div class="mx-auto flex min-h-[calc(100svh-4.25rem-1.25rem)] max-w-[90rem] flex-col justify-center gap-6 px-4 py-8 sm:px-8 lg:gap-4 lg:py-4">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-3">
        <h1 class="titulo-rotulo max-w-[18ch] text-5xl sm:text-6xl lg:max-w-none lg:text-[min(5.5vw,5rem)]">{t('hero.titulo')}</h1>
        <p class="flex flex-wrap items-baseline gap-x-5 gap-y-1 text-xl leading-snug text-tinta-suave">
          {t('hero.firma')}
          <span class="font-mono text-sm tabular-nums" data-reloj-texto hidden>{t('hero.hora')} <time data-reloj></time></span>
        </p>
      </div>

      <div>
        <div class="col-tablero hidden border-b-2 border-borde pb-2 font-display text-lg font-bold tracking-wide uppercase lg:grid" aria-hidden="true">
          <span>{t('tablero.proxima')}</span>
          <span>{t('tablero.destino')}</span>
        </div>

        <!-- Kirei: la próxima salida -->
        <div class="col-tablero grid items-center gap-y-5 border-b-2 border-borde py-5 lg:py-4">
          <h2 class="text-[25.5vw] leading-none lg:text-[min(15.5vw,33vh,14.75rem)]">
            <Paletas texto="Kirei" tono="amarillo" />
          </h2>
          <div class="flex flex-col items-start gap-4">
            <p class="titulo-rotulo text-4xl xl:text-5xl">{t('kirei.para')}</p>
            <dl class="flex flex-wrap items-end gap-x-8 gap-y-3">
              <div>
                <dt class="text-sm text-tinta-suave">{t('tablero.anden')}</dt>
                <dd class="text-[1.75rem]"><Paletas texto="1" chica /></dd>
              </div>
              <div>
                <dt class="text-sm text-tinta-suave">{t('tablero.estado')}</dt>
                <dd class="text-[1.75rem]"><Paletas texto={t('estado.proximamente')} tono="rojo" chica /></dd>
              </div>
            </dl>
            <a href={sitio.kirei.landing} class="boton-boleto">
              {t('kirei.cta')}
              <span class="-my-1 ml-1 border-l-2 border-dashed border-current py-1 pl-4 text-xl"><Flecha /></span>
            </a>
          </div>
        </div>

        <!-- Las demás salidas -->
        <ul>
          {
            siguientes.map((p) => (
              <li class="border-b border-borde">
                <a href={ruta(idioma, `projects/${separarId(p.id).slug}`)} class="col-tablero grid items-center gap-y-1 py-2.5 transition-colors duration-150 hover:bg-azul-hondo">
                  <span class="text-[1.6rem] sm:text-[1.9rem]">
                    <Paletas texto={p.data.corto} chica />
                  </span>
                  <span class="flex items-baseline justify-between gap-4 text-lg">
                    <span>{p.data.para}</span>
                    <span class="font-display font-bold tracking-wide whitespace-nowrap uppercase">
                      {t('tablero.anden')} {numeroAnden[p.data.anden]} · {t(`estado.${p.data.estado}`)}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="franjas" aria-hidden="true"></div>
  </section>

  <!-- Kirei: su sección conserva su propia identidad -->
  <section id="kirei" class="bg-kirei-tinta text-kirei-esmalte">
    <div class="mx-auto grid max-w-[90rem] gap-14 px-4 py-20 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-20 lg:py-28">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <p class="flex items-center gap-3 text-xl font-semibold">
          <svg viewBox="0 0 512 512" class="size-11" aria-hidden="true"><rect width="512" height="512" rx="112" fill="#1d6b73"></rect><path fill="#fff" d={DIENTE}></path></svg>
          Kirei
        </p>
        <h2 class="mt-7 font-kirei text-6xl leading-[0.98] font-light tracking-tight sm:text-7xl xl:text-[5.5rem]">
          {t('kirei.titulo.a')} <em class="font-normal text-kirei-menta">{t('kirei.titulo.b')}</em> {t('kirei.titulo.c')}
        </h2>
        <p class="mt-7 max-w-xl text-xl leading-relaxed text-kirei-esmalte/80">{t('kirei.texto')}</p>
        <p class="mt-5 max-w-xl leading-relaxed text-kirei-esmalte/80">{t('kirei.nacio')}</p>

        <dl class="mt-8 grid max-w-xl grid-cols-3 gap-px bg-kirei-esmalte/20">
          <div class="bg-kirei-tinta py-3 pr-3"><dt class="text-sm text-kirei-esmalte/70">Básico</dt><dd class="font-mono text-lg">$649</dd></div>
          <div class="bg-kirei-tinta py-3 pr-3 pl-4"><dt class="text-sm text-kirei-esmalte/70">Profesional</dt><dd class="font-mono text-lg">$1,099</dd></div>
          <div class="bg-kirei-tinta py-3 pr-3 pl-4"><dt class="text-sm text-kirei-esmalte/70">Clínica</dt><dd class="font-mono text-lg">$2,149</dd></div>
        </dl>
        <p class="mt-2 max-w-xl text-sm text-kirei-esmalte/70">{t('kirei.precios')}</p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={sitio.kirei.landing} class="inline-flex items-center gap-2 rounded-full bg-kirei-coral px-7 py-4 text-lg font-semibold text-kirei-tinta transition-colors duration-150 hover:bg-kirei-menta">
            {t('kirei.cta2')}
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 12h15m-6-7 7 7-7 7"></path></svg>
          </a>
          <p class="text-kirei-esmalte/80">{t('kirei.pronto')}</p>
        </div>
      </div>

      <div>
        <h3 class="font-kirei text-3xl font-light">{t('kirei.dia')}</h3>
        <ol class="mt-6">
          {
            paradas.map((p) => (
              <li class="grid grid-cols-[4.25rem_1.25rem_1fr] gap-x-3">
                <time class="pt-5 font-mono text-sm text-kirei-menta tabular-nums">{p.hora}</time>
                <span class="relative flex justify-center" aria-hidden="true">
                  <span class="absolute inset-y-0 w-0.5 bg-kirei-teal"></span>
                  <span class="relative mt-6 size-3 rounded-full bg-kirei-coral ring-4 ring-kirei-tinta"></span>
                </span>
                <div class="border-b border-kirei-esmalte/15 py-4">
                  <p class="font-kirei text-2xl leading-snug font-light">{p.titulo[idioma]}</p>
                  <p class="mt-1 text-sm text-kirei-esmalte/70">{p.modulo[idioma]}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Quién atiende -->
  <section class="mx-auto grid max-w-[90rem] gap-8 px-4 py-20 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:py-28">
    <h2 class="titulo-rotulo text-6xl sm:text-7xl lg:text-8xl">{t('julio.titulo')}</h2>
    <div class="max-w-[62ch]">
      <p class="text-2xl leading-snug font-medium">{t('julio.a')}</p>
      <p class="mt-5 text-xl leading-relaxed text-tinta-suave">{t('julio.b')}</p>
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-lg font-semibold">
        <a href={ruta(idioma, 'cv')} class="text-acento underline decoration-2 underline-offset-4">{t('julio.cv')}</a>
        <a href={sitio.github} rel="me noopener" target="_blank" class="text-acento underline decoration-2 underline-offset-4">GitHub</a>
      </p>
    </div>
  </section>

  <!-- Todas las salidas -->
  <section id="salidas" class="mx-auto max-w-[90rem] px-4 pb-20 sm:px-8 lg:pb-28">
    <h2 class="titulo-rotulo mb-12 text-6xl sm:text-7xl">{t('home.salidas')}</h2>
    <Andenes idioma={idioma} proyectos={proyectos} />
  </section>

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-[90rem] px-4 pb-20 sm:px-8">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-3 border-b-2 border-tinta pb-3">
          <h2 class="titulo-rotulo text-5xl">{t('home.blog')}</h2>
          <a href={ruta(idioma, 'blog')} class="font-semibold text-acento underline decoration-2 underline-offset-4">{t('home.verBlog')}</a>
        </div>
        <ul>
          {posts.map((post) => (
            <li class="border-b border-borde">
              <a href={ruta(idioma, `blog/${separarId(post.id).slug}`)} class="group grid gap-x-8 gap-y-1 py-4 md:grid-cols-[10rem_1fr]">
                <time datetime={post.data.pubDate.toISOString()} class="font-mono text-sm text-tinta-suave">{formatearFecha(post.data.pubDate, idioma)}</time>
                <span>
                  <span class="block text-xl font-semibold group-hover:text-acento">{post.data.title}</span>
                  <span class="mt-1 block max-w-[70ch] text-tinta-suave">{post.data.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Fin de la línea -->
  <section class="banda">
    <div class="franjas" aria-hidden="true"></div>
    <div class="mx-auto flex max-w-[90rem] flex-col gap-8 px-4 py-20 sm:px-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2 class="text-[8.5vw] sm:text-7xl lg:text-8xl"><Paletas texto={t('cierre.titulo')} /></h2>
        <p class="mt-6 max-w-xl text-xl leading-relaxed text-tinta-suave">{t('cierre.texto')}</p>
      </div>
      <div class="flex flex-wrap gap-4">
        <a href={sitio.kirei.landing} class="boton-boleto">{t('kirei.cta')}</a>
        <a href={ruta(idioma, 'contact')} class="boton-linea">{t('hero.ctaContacto')}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // La caída de paletas al cargar; sin JS o con movimiento reducido el tablero ya está completo.
  const alfabeto = 'ABCDEFGHIJKLMNÑOPQRSTUVWXYZ0123456789';
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('[data-tablero] [data-paletas]').forEach((grupo, g) => {
      grupo.querySelectorAll<HTMLElement>('.paleta').forEach((paleta, i) => {
        const final = paleta.dataset.l!;
        if (final === ' ') return;
        const vueltas = 3 + ((i * 7 + g) % 5);
        let n = 0;
        const paso = () => {
          n += 1;
          const termina = n > vueltas;
          // La letra anterior se va en la mitad que cae; la nueva ya está debajo
          paleta.dataset.previa = paleta.firstChild!.textContent ?? '';
          paleta.firstChild!.textContent = termina ? final : alfabeto[(i * 11 + n * 5 + g) % alfabeto.length];
          paleta.classList.remove('cae');
          void paleta.offsetWidth;
          paleta.classList.add('cae');
          if (!termina) setTimeout(paso, 125);
        };
        setTimeout(paso, 150 + g * 70 + i * 40);
      });
    });
  }

  // Hora real del centro de México en el tablero
  const reloj = document.querySelector<HTMLTimeElement>('[data-reloj]');
  if (reloj) {
    const formato = new Intl.DateTimeFormat('es-MX', { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit', hour12: false });
    const pinta = () => (reloj.textContent = formato.format(new Date()));
    pinta();
    document.querySelector<HTMLElement>('[data-reloj-texto]')!.hidden = false;
    setInterval(pinta, 20000);
  }
</script>
