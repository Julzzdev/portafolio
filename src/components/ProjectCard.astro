---
import Paletas from './Paletas.astro';
import type { Proyecto } from '../lib/contenido';
import { separarId, ruta, usarTraducciones } from '../i18n/utils';

interface Props {
  /** Nivel del título según la jerarquía de la página. */
  nivel?: 'h2' | 'h3' | 'h4';
  proyecto: Proyecto;
  /** La próxima salida: renglón a mayor escala. */
  destacado?: boolean;
}

const { proyecto, nivel: Titulo = 'h4', destacado = false } = Astro.props;
const { idioma, slug } = separarId(proyecto.id);
const t = usarTraducciones(idioma);
const { title, description, stack, para, estado, corto, date } = proyecto.data;
---

<article class="group col-tablero relative grid gap-y-4 border-b border-borde py-6 transition-colors duration-150 hover:bg-superficie">
  <div>
    <Titulo class:list={['block', destacado ? 'text-[17vw] sm:text-8xl' : 'text-[1.9rem]']}>
      <a href={ruta(idioma, `projects/${slug}`)} class="after:absolute after:inset-0">
        <span class="sr-only">{title}</span>
        <span aria-hidden="true"><Paletas texto={corto} tono={destacado ? 'amarillo' : 'azul'} chica={!destacado} /></span>
      </a>
    </Titulo>
    <p class:list={['mt-3 max-w-[62ch] leading-relaxed text-tinta-suave', destacado && 'text-lg']}>{description}</p>
  </div>
  <div class="flex flex-col items-start gap-3">
    <p class="text-lg font-semibold">{para}</p>
    <p class="font-mono text-xs leading-relaxed text-tinta-suave">{stack.slice(0, 5).join(' · ')}</p>
    <p class="flex items-center gap-4">
      <span class="sello">{t(`estado.${estado}`)}</span>
      <time datetime={date.toISOString()} class="font-mono text-sm text-tinta-suave tabular-nums">{date.getUTCFullYear()}</time>
    </p>
  </div>
</article>
