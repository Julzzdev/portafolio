---
interface Props {
  href: string;
  variante?: 'primario' | 'secundario';
  externo?: boolean;
}
const { href, variante = 'primario', externo = false } = Astro.props;
---

<a
  href={href}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener' : undefined}
  class:list={['boton', variante === 'primario' ? 'boton-primario' : 'boton-secundario']}
>
  <slot />
</a>
