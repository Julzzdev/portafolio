---
interface Props {
  href: string;
  variante?: 'primario' | 'secundario';
  externo?: boolean;
}
const { href, variante = 'primario', externo = false } = Astro.props;
---

<a
  href={href}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener' : undefined}
  class:list={[
    'inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition hover:-translate-y-0.5',
    variante === 'primario'
      ? 'bg-tinta text-fondo hover:shadow-lg hover:shadow-acento/25'
      : 'border border-borde bg-superficie/60 text-tinta hover:border-acento/60',
  ]}
>
  <slot />
</a>
