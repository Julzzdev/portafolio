---
interface Props {
  titulo: string;
  subtitulo?: string;
  id?: string;
  class?: string;
}
const { titulo, subtitulo, id, class: clase } = Astro.props;
---

<section id={id} class:list={['mx-auto max-w-6xl px-5 py-16 sm:py-20', clase]}>
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{titulo}</h2>
      {subtitulo && <p class="mt-2 text-tinta-suave">{subtitulo}</p>}
    </div>
    <slot name="accion" />
  </div>
  <slot />
</section>
