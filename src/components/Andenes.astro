---
import ProjectCard from './ProjectCard.astro';
import type { Proyecto } from '../lib/contenido';
import { usarTraducciones } from '../i18n/utils';
import type { Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
  proyectos: Proyecto[];
  /** Nivel de los títulos de categoría. */
  nivel?: 'h2' | 'h3';
}
const { idioma, proyectos, nivel: Titulo = 'h3' } = Astro.props;
const t = usarTraducciones(idioma);
const nivelTarjeta = Titulo === 'h2' ? 'h3' : 'h4';
const categorias = ['producto', 'medida', 'experimento'] as const;
---

<div class="grid gap-16">
  {
    categorias.map((id, i) => {
      const lista = proyectos.filter((p) => p.data.anden === id);
      return (
        <section>
          <div class="mb-2 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-tinta pb-3">
            <span class="etiqueta" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <Titulo class="text-2xl font-semibold tracking-tight">{t(`anden.${id}`)}</Titulo>
            <p class="text-tinta-suave">{t(`anden.${id}.nota`)}</p>
            <span class="etiqueta ml-auto" aria-hidden="true">{lista.length}</span>
          </div>
          {lista.map((proyecto) => <ProjectCard proyecto={proyecto} nivel={nivelTarjeta} destacado={id === 'producto'} />)}
        </section>
      );
    })
  }
</div>
