---
import type { Post } from '../lib/contenido';
import { formatearFecha, ruta, separarId } from '../i18n/utils';

interface Props {
  /** Nivel del título según la jerarquía de la página. */
  nivel?: 'h2' | 'h3';
  post: Post;
}
const { post, nivel: Titulo = 'h3' } = Astro.props;
const { idioma, slug } = separarId(post.id);
---

<article class="group relative border-t border-borde py-6">
  <time datetime={post.data.pubDate.toISOString()} class="etiqueta">
    {formatearFecha(post.data.pubDate, idioma)}
  </time>
  <Titulo class="mt-2 text-xl font-semibold tracking-tight group-hover:text-acento">
    <a href={ruta(idioma, `blog/${slug}`)} class="after:absolute after:inset-0">{post.data.title}</a>
  </Titulo>
  <p class="mt-2 leading-relaxed text-tinta-suave">{post.data.description}</p>
</article>
