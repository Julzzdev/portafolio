---
import { getIdiomaDeUrl, ruta, usarTraducciones } from '../i18n/utils';
import { sitio } from '../config/sitio';
import Marca from './Marca.astro';

const idioma = getIdiomaDeUrl(Astro.url);
const t = usarTraducciones(idioma);
const redes = [
  { href: ruta(idioma, 'cv'), texto: t('nav.cv') },
  { href: sitio.github, texto: 'GitHub' },
  { href: sitio.linkedin, texto: 'LinkedIn' },
  { href: `mailto:${sitio.email}`, texto: 'Email' },
];
---

<footer class="border-t border-borde bg-superficie">
  <div class="contenedor grid gap-8 py-10 sm:grid-cols-[1fr_auto] sm:items-start">
    <div>
      <Marca />
      <p class="mt-3 max-w-md text-sm leading-relaxed text-tinta-suave">{t('footer.hecho')}</p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
      {
        redes.map(({ href, texto }) => (
          <li>
            <a href={href} class="text-tinta-suave transition-colors hover:text-tinta" rel={href.startsWith('http') ? 'me noopener' : undefined} target={href.startsWith('http') ? '_blank' : undefined}>
              {texto}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="border-t border-borde">
    <div class="contenedor flex flex-col justify-between gap-2 py-4 font-mono text-xs text-tinta-suave sm:flex-row">
      <p>© {new Date().getFullYear()} {sitio.marca} · {sitio.ubicacion}</p>
      <p>{t('footer.tecnico')}</p>
    </div>
  </div>
</footer>
