---
interface Props {
  titulo: string;
  descripcion?: string;
  /** Etiqueta técnica sobre el título. */
  etiqueta?: string;
}
const { titulo, descripcion, etiqueta } = Astro.props;
---

<header class="relative overflow-hidden border-b border-borde">
  <div class="rejilla pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="contenedor relative pt-12 pb-12 sm:pt-16 sm:pb-14">
    <slot name="antes" />
    {etiqueta && <p class="etiqueta mb-4">{etiqueta}</p>}
    <h1 class="titulo max-w-[24ch] text-4xl sm:text-6xl">{titulo}</h1>
    {descripcion && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-tinta-suave sm:text-xl">{descripcion}</p>}
    <slot />
  </div>
</header>
