---
import { idiomas, type Idioma } from '../i18n/ui';
import { cambiarIdioma, getIdiomaDeUrl, ruta, usarTraducciones } from '../i18n/utils';
import { sitio } from '../config/sitio';
import ThemeToggle from './ThemeToggle.astro';
import Paletas from './Paletas.astro';

interface Props {
  alternos?: Idioma[];
}

const idioma = getIdiomaDeUrl(Astro.url);
const t = usarTraducciones(idioma);
const { alternos = Object.keys(idiomas) as Idioma[] } = Astro.props;
const otro = (Object.keys(idiomas) as Idioma[]).find((i) => i !== idioma)!;
const urlOtro = alternos.includes(otro) ? cambiarIdioma(Astro.url, otro) : ruta(otro);

const enlaces = [
  { href: `${ruta(idioma)}#kirei`, texto: 'Kirei' },
  { href: ruta(idioma, 'projects'), texto: t('nav.proyectos') },
  { href: ruta(idioma, 'blog'), texto: t('nav.blog') },
  { href: ruta(idioma, 'contact'), texto: t('nav.contacto') },
];
const activo = (href: string) => !href.includes('#') && Astro.url.pathname.startsWith(href.replace(/\/$/, ''));
---

<header class="banda sticky top-0 z-40">
  <nav class="mx-auto flex h-[4.25rem] max-w-[90rem] items-center justify-between gap-3 px-4 sm:px-8">
    <a href={ruta(idioma)} class="text-[1.45rem]" aria-label={`${sitio.marca}, ${t('nav.inicio')}`}>
      <Paletas texto="Julzz" tono="amarillo" chica />
      <span class="titulo-rotulo ml-1 align-middle">Labs</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        enlaces.map(({ href, texto }) => (
          <li>
            <a
              href={href}
              aria-current={activo(href) ? 'page' : undefined}
              class="rounded-[3px] px-3.5 py-2 font-display text-lg font-bold tracking-wide uppercase transition-colors hover:bg-azul-hondo aria-[current=page]:bg-azul-hondo"
            >
              {texto}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <a
        href={urlOtro}
        hreflang={idiomas[otro].bcp47}
        lang={idiomas[otro].bcp47}
        class="rounded-[3px] px-3 py-2 font-display text-lg font-bold transition-colors hover:bg-azul-hondo"
        aria-label={idiomas[otro].nombre}
      >
        {idiomas[otro].corto}
      </a>
      <ThemeToggle etiqueta={t('tema.cambiar')} />

      <details class="relative md:hidden">
        <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-[3px] hover:bg-azul-hondo [&::-webkit-details-marker]:hidden" aria-label={t('nav.menu')}>
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul class="absolute right-0 mt-3 w-52 rounded-[3px] bg-azul-hondo p-2 shadow-xl">
          {
            enlaces.map(({ href, texto }) => (
              <li>
                <a href={href} class="block px-3 py-3 font-display text-xl font-bold uppercase hover:text-amarillo">
                  {texto}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>
