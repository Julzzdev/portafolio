---
import { idiomas, type Idioma } from '../i18n/ui';
import { cambiarIdioma, getIdiomaDeUrl, ruta, usarTraducciones } from '../i18n/utils';
import { sitio } from '../config/sitio';
import ThemeToggle from './ThemeToggle.astro';
import Marca from './Marca.astro';

interface Props {
  alternos?: Idioma[];
}

const idioma = getIdiomaDeUrl(Astro.url);
const t = usarTraducciones(idioma);
const { alternos = Object.keys(idiomas) as Idioma[] } = Astro.props;
const otro = (Object.keys(idiomas) as Idioma[]).find((i) => i !== idioma)!;
const urlOtro = alternos.includes(otro) ? cambiarIdioma(Astro.url, otro) : ruta(otro);

const enlaces = [
  { href: `${ruta(idioma)}#kirei`, texto: 'Kirei' },
  { href: ruta(idioma, 'projects'), texto: t('nav.proyectos') },
  { href: ruta(idioma, 'cv'), texto: t('nav.cv') },
  { href: ruta(idioma, 'blog'), texto: t('nav.blog') },
];
const activo = (href: string) => !href.includes('#') && Astro.url.pathname.startsWith(href.replace(/\/$/, ''));
---

<header class="sticky top-0 z-40 border-b border-borde bg-fondo/85 backdrop-blur-md">
  <nav class="contenedor flex h-16 items-center justify-between gap-3">
    <a href={ruta(idioma)} aria-label={`${sitio.marca}, ${t('nav.inicio')}`}>
      <Marca />
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        enlaces.map(({ href, texto }) => (
          <li>
            <a
              href={href}
              aria-current={activo(href) ? 'page' : undefined}
              class="rounded-md px-3 py-2 text-[0.95rem] font-medium text-tinta-suave transition-colors hover:text-tinta aria-[current=page]:text-tinta aria-[current=page]:underline aria-[current=page]:decoration-acento aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[1.35rem]"
            >
              {texto}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <a
        href={urlOtro}
        hreflang={idiomas[otro].bcp47}
        lang={idiomas[otro].bcp47}
        class="grid h-10 place-items-center rounded-md px-2.5 font-mono text-xs font-medium text-tinta-suave transition-colors hover:bg-superficie-2 hover:text-tinta"
        aria-label={idiomas[otro].nombre}
      >
        {idiomas[otro].corto}
      </a>
      <ThemeToggle etiqueta={t('tema.cambiar')} />
      <a href={ruta(idioma, 'contact')} class="boton boton-primario ml-2 hidden min-h-10 px-4 text-sm sm:inline-flex">
        {t('nav.contacto')}
      </a>

      <details class="relative md:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-md hover:bg-superficie-2 [&::-webkit-details-marker]:hidden" aria-label={t('nav.menu')}>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul class="absolute right-0 mt-3 w-56 rounded-xl border border-borde bg-superficie p-2 shadow-xl shadow-black/10">
          {
            [...enlaces, { href: ruta(idioma, 'contact'), texto: t('nav.contacto') }].map(({ href, texto }) => (
              <li>
                <a href={href} class="block rounded-md px-3 py-3 font-medium hover:bg-superficie-2">
                  {texto}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>
