---
import { idiomas, type Idioma } from '../i18n/ui';
import { cambiarIdioma, getIdiomaDeUrl, ruta, usarTraducciones } from '../i18n/utils';
import { sitio } from '../config/sitio';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  alternos?: Idioma[];
}

const idioma = getIdiomaDeUrl(Astro.url);
const t = usarTraducciones(idioma);
const { alternos = Object.keys(idiomas) as Idioma[] } = Astro.props;
const otro = (Object.keys(idiomas) as Idioma[]).find((i) => i !== idioma)!;
const urlOtro = alternos.includes(otro) ? cambiarIdioma(Astro.url, otro) : ruta(otro);

const enlaces = [
  { href: ruta(idioma, 'projects'), texto: t('nav.proyectos') },
  { href: ruta(idioma, 'blog'), texto: t('nav.blog') },
  { href: ruta(idioma, 'cv'), texto: t('nav.cv') },
  { href: ruta(idioma, 'contact'), texto: t('nav.contacto') },
];
const activo = (href: string) => Astro.url.pathname.startsWith(href.replace(/\/$/, ''));
---

<header class="sticky top-0 z-40 border-b border-borde/60 bg-fondo/75 backdrop-blur-lg">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href={ruta(idioma)} class="group flex items-center gap-2 font-semibold tracking-tight" aria-label={`${sitio.nombre} — ${t('nav.inicio')}`}>
      <span class="grid size-9 place-items-center rounded-xl bg-gradient-to-br from-acento to-acento-2 font-mono text-sm font-bold text-white shadow-lg shadow-acento/25 transition group-hover:rotate-6">
        {sitio.iniciales}
      </span>
      <span class="hidden sm:inline">{sitio.nombre}</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        enlaces.map(({ href, texto }) => (
          <li>
            <a
              href={href}
              aria-current={activo(href) ? 'page' : undefined}
              class="rounded-full px-3.5 py-2 text-sm text-tinta-suave transition hover:text-tinta aria-[current=page]:bg-borde/60 aria-[current=page]:text-tinta"
            >
              {texto}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <a
        href={urlOtro}
        hreflang={idiomas[otro].bcp47}
        lang={idiomas[otro].bcp47}
        class="rounded-full px-3 py-2 font-mono text-xs font-semibold text-tinta-suave transition hover:bg-borde/60 hover:text-tinta"
        aria-label={idiomas[otro].nombre}
      >
        {idiomas[otro].corto}
      </a>
      <ThemeToggle etiqueta={t('tema.cambiar')} />

      <details class="relative md:hidden">
        <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-full text-tinta-suave hover:bg-borde/60 [&::-webkit-details-marker]:hidden" aria-label={t('nav.menu')}>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
          </svg>
        </summary>
        <ul class="absolute right-0 mt-3 w-48 rounded-2xl border border-borde bg-superficie p-2 shadow-xl">
          {
            enlaces.map(({ href, texto }) => (
              <li>
                <a href={href} class="block rounded-xl px-3 py-2 text-sm hover:bg-borde/60">
                  {texto}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>
